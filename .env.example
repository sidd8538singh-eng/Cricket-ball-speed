# ==============================================================================
# Cricket Ball Speed Analyzer - Environment Variables
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# Server configuration
PORT=8000
HOST=0.0.0.0
WORKERS=1

# Security & CORS (comma-separated list of allowed origins, or * for all)
CORS_ORIGINS=*

# Logging configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Application limits
MAX_UPLOAD_SIZE_MB=500

# Optional PyTorch hardware device ("auto", "cpu", "cuda", "cuda:0")
INFERENCE_DEVICE=auto
